@page
@model PedidoModel
@using System.Globalization
@{
    ViewData["Title"] = "Pedido";
}

<h1 class="mb-4">Hacer un pedido</h1>

@if (Model.Total is not null)
{
    @* Resumen mostrado después de un OnPost() válido. *@
    <div class="card border-success shadow-sm">
        <div class="card-header bg-success text-white">Pedido registrado</div>
        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>Cliente:</strong> @Model.Datos.Nombre (@Model.Datos.Correo, @Model.Datos.Telefono)</li>
            <li class="list-group-item"><strong>Producto:</strong> @Model.ProductoElegido!.Nombre x @Model.Datos.Cantidad, tamaño @Model.Datos.Tamaño</li>
            <li class="list-group-item"><strong>Extras:</strong> @(Model.Datos.Extras.Any() ? string.Join(", ", Model.Datos.Extras) : "Ninguno")</li>
            <li class="list-group-item"><strong>Entrega:</strong> @(Model.Datos.EntregaDomicilio ? "A domicilio en " + Model.Datos.Direccion : "Recoger en tienda")</li>
            <li class="list-group-item fs-5"><strong>Total:</strong> @Model.Total.Value.ToString("C")</li>
        </ul>
    </div>
    <a asp-page="/Pedido" class="btn btn-outline-secondary mt-3">Nuevo pedido</a>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            @* novalidate desactiva los globos nativos del navegador; la validación la hace jQuery Validation. *@
            <form method="post" id="frmPedido" class="card card-body shadow-sm" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- Input de texto -->
                <div class="mb-3">
                    <label asp-for="Datos.Nombre" class="form-label"></label>
                    <input asp-for="Datos.Nombre" class="form-control" autocomplete="name" />
                    <span asp-validation-for="Datos.Nombre" class="text-danger"></span>
                </div>

                <div class="row">
                    <!-- Input de correo -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Datos.Correo" class="form-label"></label>
                        <input asp-for="Datos.Correo" type="email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Datos.Correo" class="text-danger"></span>
                    </div>
                    <!-- Input de teléfono -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Datos.Telefono" class="form-label">Teléfono (10 dígitos)</label>
                        <input asp-for="Datos.Telefono" type="tel" class="form-control" maxlength="10" inputmode="numeric" autocomplete="tel" />
                        <span asp-validation-for="Datos.Telefono" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <!-- Select: lista desplegable llenada con asp-items -->
                    <div class="col-md-8 mb-3">
                        <label asp-for="Datos.ProductoId" class="form-label"></label>
                        <select asp-for="Datos.ProductoId" asp-items="Model.ListaProductos" class="form-select">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span asp-validation-for="Datos.ProductoId" class="text-danger"></span>
                    </div>
                    <!-- Input numérico -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="Datos.Cantidad" class="form-label"></label>
                        <input asp-for="Datos.Cantidad" type="number" class="form-control" />
                        <span asp-validation-for="Datos.Cantidad" class="text-danger"></span>
                    </div>
                </div>

                <!-- RadioButton: una sola opción. data-recargo lleva el precio extra de cada tamaño. -->
                <fieldset class="mb-3">
                    <legend class="fs-6 fw-semibold">Tamaño</legend>
                    @foreach (var tamaño in PedidoModel.Tamaños)
                    {
                        var recargo = PedidoModel.RecargosTamaño[tamaño];
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="Datos.Tamaño"
                                   id="tamano_@tamaño" value="@tamaño"
                                   data-recargo="@recargo.ToString(CultureInfo.InvariantCulture)" />
                            <label class="form-check-label" for="tamano_@tamaño">
                                @tamaño @(recargo > 0 ? $"(+{recargo:C})" : "")
                            </label>
                        </div>
                    }
                    <div><span asp-validation-for="Datos.Tamaño" class="text-danger"></span></div>
                </fieldset>

                <!-- CheckBox: varias selecciones (comparten name="Datos.Extras") -->
                <fieldset class="mb-3">
                    <legend class="fs-6 fw-semibold">Extras (+@PedidoModel.PrecioExtra.ToString("C") cada uno, por unidad)</legend>
                    @for (int i = 0; i < PedidoModel.ExtrasDisponibles.Length; i++)
                    {
                        var extra = PedidoModel.ExtrasDisponibles[i];
                        <div class="form-check">
                            <input class="form-check-input chk-extra" type="checkbox" name="Datos.Extras"
                                   id="extra_@i" value="@extra"
                                   data-precio="@PedidoModel.PrecioExtra.ToString(CultureInfo.InvariantCulture)"
                                   checked="@Model.Datos.Extras.Contains(extra)" />
                            <label class="form-check-label" for="extra_@i">@extra</label>
                        </div>
                    }
                </fieldset>

                <!-- CheckBox individual: entrega a domicilio -->
                <div class="form-check mb-3">
                    <input asp-for="Datos.EntregaDomicilio" class="form-check-input"
                           data-precio="@PedidoModel.CostoEnvio.ToString(CultureInfo.InvariantCulture)" />
                    <label asp-for="Datos.EntregaDomicilio" class="form-check-label">
                        Entrega a domicilio (+@PedidoModel.CostoEnvio.ToString("C"))
                    </label>
                </div>

                <!-- Input de dirección: se muestra y es obligatorio solo si hay entrega a domicilio -->
                <div class="mb-3" id="grupoDireccion">
                    <label asp-for="Datos.Direccion" class="form-label"></label>
                    <input asp-for="Datos.Direccion" class="form-control" autocomplete="street-address"
                           placeholder="Calle, número, colonia" />
                    <span asp-validation-for="Datos.Direccion" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-cafe">Enviar pedido</button>
                    <button type="button" id="btnLimpiar" class="btn btn-outline-secondary">Limpiar</button>
                </div>
            </form>
        </div>

        <!-- Panel con el total estimado: lo actualiza JavaScript en cada cambio del formulario -->
        <div class="col-lg-4">
            <div class="card shadow-sm position-sticky" style="top: 1rem;">
                <div class="card-body">
                    <h2 class="h5">Total estimado</h2>
                    <p id="lblTotal" class="total-estimado mb-2">$0.00</p>
                    <p id="lblDetalle" class="small text-muted mb-0">Elige un producto y un tamaño.</p>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @* Validación en el cliente que incluye la plantilla de Razor Pages (jQuery Validation + Unobtrusive). *@
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Precios del catálogo enviados por el servidor como JSON: { "1": 35, "2": 45, ... }
        const preciosProductos = @Json.Serialize(Model.PreciosProductos);
    </script>
    <script src="~/js/pedido.js" asp-append-version="true"></script>
}
