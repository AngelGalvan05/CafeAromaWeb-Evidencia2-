<!DOCTYPE html>
<html lang="es-MX">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Café Aroma</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CafeAromaWeb_Ev2.styles.css" asp-append-version="true" />
</head>
<body>
    @* Diseño común: barra de navegación con las cinco páginas del sitio (Tag Helper asp-page). *@
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark barra-cafe mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-page="/Index">☕ Café Aroma</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Mostrar menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Menu">Menú</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Nosotros">Nosotros</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Contacto">Contacto</a></li>
                    </ul>
                    <a class="btn btn-crema btn-sm" asp-page="/Pedido">Hacer pedido</a>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - Café Aroma · CafeAromaWeb · <a asp-page="/Privacy">Aviso de privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Cada página puede agregar sus propios scripts en la sección "Scripts". *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
